{
  "plugins": ["oxc"],
  "categories": {
    "correctness": "error",
    "perf": "error"
  },
  "ignorePatterns": ["vendor/"],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "unicorn/prefer-set-has": "off",
    "no-unused-expressions": ["error", { "allowShortCircuit": true }],
    "eqeqeq": ["error", "always"],
    "@typescript-eslint/no-array-delete": "off"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  }
}
